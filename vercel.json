{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": { "root": ".", "framework": "vite" },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "bindings": [
        { "type": "service", "service": "storage", "format": "url", "env": "STORAGE_URL" }
      ]
    },
    "storage": { "root": "services/storage", "framework": "express" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
