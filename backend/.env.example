# All paths are server configuration. Use the SAME absolute local DATA_DIR in both processes.
APP_ENV=development
PIPELINE_MODE=disabled
DATA_DIR=C:/Users/Shwepes/datathon/backend/data
# Empty fails closed. Set a secret here only when connecting the real pipeline.
JURY_API_KEY=
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Explicit HTTP development mode; production requires true and HTTPS.
COOKIE_SECURE=false
SESSION_TTL_SEC=2592000
UPLOAD_LIMIT_BYTES=268435456
JOB_TIMEOUT_SEC=300
QUEUE_CAPACITY=20
WORKER_POLL_SEC=0.25
WORKER_STALE_SEC=10
WORKER_STARTUP_TIMEOUT_SEC=60
MEDIA_TIMEOUT_SEC=30
FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe
# Development only: no_violation | violations | failure. Never selected by filename/content.
MOCK_SCENARIO=no_violation
